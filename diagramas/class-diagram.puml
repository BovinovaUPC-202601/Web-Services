' ==================== IoTMonitoring ====================
package "IoTMonitoring" as BC_IOT #FFFDF4 {
  package "Interfaces" as IO_I {
    class CollarController
    class BovineHealthRecordController
    class CollarRecoveryController
  }
  package "Application" as IO_A {
    class CollarCommandService
    class CollarQueryService
    class BovineHealthRecordCommandService
    class BovineHealthRecordQueryService
    class SubscriptionContextFacade <<ACL>>
  }
  package "Domain" as IO_D {
    class Collar {
      +Id : int
      +DeviceId : string
      +BovineId : int
      +UserId : int
      +LifecycleStatus : CollarLifecycleStatus
      +ResolveOperationalStatus() : CollarOperationalStatus
