    }
    interface ICollarRepository
    interface IBovineHealthRecordRepository
  }
  package "Infrastructure" as IO_INF {
    class CollarRepository
    class BovineHealthRecordRepository
    class MqttTelemetryConsumer <<MQTT>>
  }
  IO_I -[hidden]down- IO_A
  IO_A -[hidden]down- IO_D
  IO_D -[hidden]down- IO_INF
}

