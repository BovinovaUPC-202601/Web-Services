' ==================== RanchManagement ====================
package "RanchManagement" as BC_RANCH #FFFDF4 {
  package "Interfaces" as RA_I {
    class BovineController
    class StableController
    class InventoryController
  }
  package "Application" as RA_A {
    class BovineCommandService
    class BovineQueryService
    class StableCommandService
    class StableQueryService
    class ProductCommandService
    class CategoryCommandService
    class BovineBreedCommandService
  }
  package "Domain" as RA_D {
    class Bovine {
      +Id : int
      +Name : string
      +Gender : string
      +BirthDate : DateOnly
      +Breed : string
      +StableId : int
      +UserId : int
      +MinTemperature : double
      +MaxTemperature : double
      +MinHeartRate : int
      +MaxHeartRate : int
    }
    class Stable {
      +Id : int
      +Name : string
      +Limit : int
      +UserId : int
    }
    class Product {
      +Id : int
      +Name : string
      +CategoryId : int
      +Quantity : int
      +UserId : int
