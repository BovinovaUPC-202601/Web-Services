' ==================== AlertManagement ====================
package "AlertManagement" as BC_ALERT #F4F8F2 {
  package "Interfaces" as AL_I {
    class AlertController
  }
  package "Application" as AL_A {
    class AlertCommandService
    class AlertQueryService
    class AbnormalTelemetryDetectedHandler
    class SubscriptionEndedHandler
  }
